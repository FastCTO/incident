namespace App\Http\Controllers;

use Illuminate\Support\Facades\Auth;

class HomeController extends Controller
{
    public function index()
    {
        $user = Auth::user();

        if ($user->current_room) {
            return redirect()->route('dashboard'); // Redirect if the user has a room
        }

        return redirect()->route('dashboard'); // For consistency, we use the same dashboard
    }
}

<?php
namespace App\Http\Controllers;

use Illuminate\Http\Request;
use App\Models\SchoolInfo;
use App\Models\Room;
use Illuminate\Support\Facades\Auth;

class DashboardController extends Controller
{
    public function index()
    {
	     // Get school information
        $school = SchoolInfo::first(); // Assuming a single school record exists
        $occupiedRooms = Room::where('status', 'occupied')->count();
        $totalOccupancy = Room::sum('current_occupancy');
        $emergencyStatus = $school->status; // 'status' column indicating emergency state

        return view('dashboard', [
            'school' => $school,
            'occupiedRooms' => $occupiedRooms,
            'totalOccupancy' => $totalOccupancy,
            'emergencyStatus' => $emergencyStatus,
            'userRoom' => $user->current_room,
            'isRoomLeader' => $user->room_leader,
        ]);
    }
}
