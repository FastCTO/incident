namespace App\Http\Controllers;

use Illuminate\Http\Request;

class EmergencyChatController extends Controller
{
    private $chatFile = 'storage/emergency_chat.json';

    public function fetchMessages()
    {
        if (!file_exists($this->chatFile)) {
            return response()->json([]);
        }

        $messages = json_decode(file_get_contents($this->chatFile), true);
        return response()->json($messages);
    }

    public function sendMessage(Request $request)
    {
        $request->validate([
            'message' => 'required|string|max:255',
        ]);

        $user = auth()->user();
        $newMessage = [
            'user' => $user->name,
            'message' => $request->message,
            'timestamp' => now()->toDateTimeString(),
        ];

        $messages = [];
        if (file_exists($this->chatFile)) {
            $messages = json_decode(file_get_contents($this->chatFile), true);
        }

        $messages[] = $newMessage;

        // Save to file (simulate database for simplicity)
        file_put_contents($this->chatFile, json_encode($messages));

        return response()->json($newMessage);
    }
}

