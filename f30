<div class="container">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">Emergency School Chat</div>
                <div class="card-body">
                    <div id="chat-box" style="border: 1px solid #ccc; padding: 10px; height: 400px; overflow-y: auto;">
                        <!-- Messages will appear here -->
                    </div>
                    <div class="mt-3">
                        <input type="text" id="chat-input" class="form-control" placeholder="Type a message...">
                        <button class="btn btn-primary mt-2 w-100" onclick="sendMessage()">Send</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    async function fetchMessages() {
        const response = await fetch('{{ route('emergency.chat.fetch') }}');
        const messages = await response.json();
        const chatBox = document.getElementById('chat-box');
        chatBox.innerHTML = '';
        messages.forEach(msg => {
            chatBox.innerHTML += `<div><strong>${msg.user}</strong>: ${msg.message} <small>(${msg.timestamp})</small></div>`;
        });
        chatBox.scrollTop = chatBox.scrollHeight;
    }

    async function sendMessage() {
        const message = document.getElementById('chat-input').value;
        if (!message) return;

        const response = await fetch('{{ route('emergency.chat.send') }}', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'X-CSRF-TOKEN': '{{ csrf_token() }}',
            },
            body: JSON.stringify({ message }),
        });

        if (response.ok) {
            fetchMessages();
            document.getElementById('chat-input').value = '';
        }
    }

    // Fetch messages every 5 seconds
    setInterval(fetchMessages, 5000);
    fetchMessages();
</script>
